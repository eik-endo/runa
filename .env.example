# Copie para .env.local para rodar com um projeto Supabase.
# Na Vercel, a integração Supabase (Storage → Supabase) cria estas variáveis sozinha.

# Público (vai para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor: cria contas de usuário/senha e de convidado
SUPABASE_SERVICE_ROLE_KEY=

# Usado pelo build para criar as tabelas (scripts/migrate.mjs)
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=

# Opcional: domínio reservado usado para transformar "usuário" em login do Supabase (nenhum e-mail é enviado)
# NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=jogadores.runa.invalid
